# ============================================================================
# SentinelAI backend configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ============================================================================

# --- Gemini (Google Gen AI) -------------------------------------------------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional overrides (defaults shown):
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- GitHub -----------------------------------------------------------------
# A Personal Access Token (fine-grained or classic) with `repo` read access.
# Create at https://github.com/settings/tokens
# Optional for public repos, but avoids strict rate limits.
GITHUB_TOKEN=your_github_token
# GITHUB_API_VERSION=2022-11-28
# COMMIT_SCAN_LIMIT=30

# --- Slack ------------------------------------------------------------------
# Global fallback Incoming Webhook. Per-project webhooks (sent per request)
# take precedence. Create at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- ChromaDB ---------------------------------------------------------------
# Where the on-disk vector store lives (mounted as a volume in Docker).
# CHROMA_PERSIST_DIR=./data/chroma
# RUNBOOKS_COLLECTION=runbooks

# --- Frontend redirect (Sentry OAuth return) --------------------------------
# Where /api/sentry/callback sends the browser after authorization.
# Local Docker: http://localhost:8443
# Render/production: your Vercel URL (e.g. https://your-app.vercel.app)
FRONTEND_URL=http://localhost:8443

# --- Sentry (autonomous mode) -----------------------------------------------
# SentinelAI uses TWO separate Sentry configs. Do not mix them up.
#
# ── A) OAuth Application — "Connect Sentry" in the SentinelAI UI ───────────
# Where: Sentry → Settings → Developer Settings → OAuth Applications
#   1. Open your existing OAuth app (or create one)
#   2. Authorization callback URL: http://localhost:8000/api/sentry/callback
#   3. Copy Client ID + Client Secret → SENTRY_CLIENT_ID / SENTRY_CLIENT_SECRET
#
# ── B) Internal Integration — automatic incidents via webhook ─────────────
# Where: Sentry → Settings → Custom Integrations  (NOT "OAuth Applications")
#   OAuth Applications is a different sidebar item under Developer Settings.
#   Custom Integrations is where Internal Integrations live.
#
#   Step-by-step to get SENTRY_WEBHOOK_SECRET:
#   1. Open https://sentry.io/settings/  and pick your organization
#   2. In the left sidebar, click **Custom Integrations**
#      (If you don't see it: go directly to
#       https://sentry.io/settings/YOUR-ORG-SLUG/developer-settings/new-internal/
#       replacing YOUR-ORG-SLUG with your org slug from the Sentry URL)
#   3. Click **Create New Integration** → choose **Internal Integration** → **Next**
#   4. Fill in:
#        Name: SentinelAI Webhooks
#        Webhook URL: http://localhost:8000/api/sentry/webhook
#          (Sentry cannot reach localhost — use ngrok for local dev, e.g.
#           https://abc123.ngrok-free.app/api/sentry/webhook)
#      Permissions → Issue & Event: **Read**
#      Webhooks → enable **Issue** (fires on new/updated issues)
#   5. Click **Save Changes**
#   6. Scroll to the **Credentials** section at the bottom of the page
#   7. Copy **Client Secret** → paste as SENTRY_WEBHOOK_SECRET below
#      ⚠️  Sentry may only show the Client Secret once at creation. Copy it now.
#      If you lose it, open the integration again → Credentials → regenerate.
#
SENTRY_CLIENT_ID=your_oauth_client_id
SENTRY_CLIENT_SECRET=your_oauth_client_secret
SENTRY_REDIRECT_URI=http://localhost:8000/api/sentry/callback
SENTRY_WEBHOOK_SECRET=your_internal_integration_client_secret

# --- Supabase admin (store Sentry tokens server-side) -----------------------
# Service role key — never expose in the frontend.
# Go to Settings -> Configuration -> API Keys -> Legacy anon, service_role API keys to get your service role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
